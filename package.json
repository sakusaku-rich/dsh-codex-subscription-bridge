{
  "name": "dsh-codex-subscription-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A direct DeepSeek Harness provider for dedicated ChatGPT subscription OAuth",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src/index.js",
    "src/direct.js",
    "src/auth.js",
    "src/auth-cli.js",
    "src/http.js",
    "src/text.js",
    "src/errors.js",
    "src/environment.js",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "test:isolation": "node --test test/real-isolation.test.mjs",
    "test:profile": "node scripts/verify-profile.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-codex-subscription-auth": "./src/auth-cli.js"
  }
}
