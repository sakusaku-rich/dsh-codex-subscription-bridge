{
  "name": "dsh-codex-subscription-bridge",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "description": "A direct DeepSeek Harness provider for dedicated ChatGPT subscription OAuth",
  "author": "sakusaku-rich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakusaku-rich/dsh-codex-subscription-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/sakusaku-rich/dsh-codex-subscription-bridge/issues"
  },
  "homepage": "https://github.com/sakusaku-rich/dsh-codex-subscription-bridge#readme",
  "keywords": [
    "deepseek-harness",
    "chatgpt",
    "codex",
    "subscription",
    "oauth",
    "plugin"
  ],
  "engines": {
    "node": ">=22.23.3 <23 || 24.21.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compaction": "./lib/compaction-engine.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "lib/types",
    "presets",
    "cordis.patch.yml",
    "client.js",
    "README.md",
    "SECURITY.md",
    "docs",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "preset:sync": "node scripts/sync-preset.mjs",
    "preset:check": "node scripts/sync-preset.mjs --check",
    "test:profile": "node scripts/verify-profile.mjs",
    "prepare:profile": "node scripts/prepare-profile.mjs",
    "prepare:release": "npm run build && node scripts/build-release-asset.mjs",
    "test:install": "node --test test/integration/prepare-profile.test.mjs",
    "test:profile-install": "node --test test/integration/profile-install.test.mjs",
    "test:release-install": "node --test test/integration/release-install.test.mjs test/integration/release-download.test.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "test:auth-ui": "node --test test/integration/auth-ui-http.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/codex-subscription.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "bin": {
    "dsh-codex-subscription-auth": "./lib/auth-cli.js"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "7.29.1"
  },
  "bundledDependencies": [
    "undici"
  ],
  "bundleDependencies": [
    "undici"
  ]
}
